# 쉼표로 구분한 허용 Origin 목록 (비우면 기본값 http://localhost:5173)
CORS_ORIGINS=
# 매물 CSV 경로 (비우면 기본값 ../DB/poc_ewha.csv). 상대 경로는 BE/ 기준.
# 예: 이대 주변 직방 월세 데이터 (pipeline 으로 만든 로컬 파일, 커밋 안 함) ../DB/staging/ewha_candidates_v2_student.csv
DATA_CSV_PATH=
# 매물 × 강의동 도보시간 표 (pipeline.build_walk_table). 비우면 매물 CSV 의 강의동 4곳(spot1~4)만 씀. 상대 경로는 BE/ 기준.
WALK_TABLE_PATH=

# AI 챗봇 (POST /agent/chat, LangGraph). 어떤 LLM 을 쓸지: exaone(기본) | gemini
# 비우면 챗봇은 '설정 안 됨'으로 답하고 기존 추천은 그대로 동작. 키는 BE/.env.local 에만 넣고 커밋·FE 에 넣지 않는다.
LLM_PROVIDER=exaone
# 선택: 주 공급자가 하루 한도(그날 자정까지 건너뜀)·혼잡·인증 오류일 때 차례로 쓸 공급자 (쉼표). 예: gemini
LLM_FALLBACK_PROVIDERS=gemini
# 선택: 혼잡으로 실패한 공급자를 건너뛰는 시간(초, 기본 300)
LLM_BUSY_COOLDOWN_S=

# LG EXAONE (OpenAI 호환 chat completions). 주소·모델 이름은 제공처 문서에서 확인한 값을 넣는다 (추측 금지).
#   LG EXAONE API 플랫폼(docs.exaone.ai) 또는 FriendliAI 서버리스 등 — 제공처의 base URL 과 모델 ID
EXAONE_API_KEY=
EXAONE_BASE_URL=
EXAONE_MODEL=
# 선택: 대체 모델(쉼표), 추론 강도(제공처가 지원할 때만, 예: low), 구조화 출력 방식(prompt 기본 | json_schema)
EXAONE_FALLBACK_MODELS=
EXAONE_REASONING_EFFORT=
EXAONE_JSON_MODE=prompt
# 챗봇 설명: on(조건 추출과 같은 LLM) | off(서버가 만든 사실 문장) | gemini·exaone(설명만 그 공급자). 비우면 on.
# EXAONE(k-exaone_v2.5)은 설명이 60초를 넘어(2026-11-15 실측) 설명만 Gemini 로 돌리는 것을 권장
AGENT_LLM_EXPLAIN=gemini

# Gemini (LLM_PROVIDER=gemini 일 때, 또는 모델 비교 평가용). 키는 Google AI Studio 에서 발급.
# 모델 ID 는 계정에서 쓸 수 있는 Gemini Flash 계열로 (AI Studio 모델 목록에서 확인).
GEMINI_API_KEY=
GEMINI_MODEL=
# 선택: 주 모델이 혼잡(503)·시간 초과(504)·없음(404)일 때 차례로 쓸 모델 (쉼표). 예: gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=

# LLM (scripts/ask.py)
OPENAI_API_KEY=
# 선택: OpenRouter 등 OpenAI 호환 엔드포인트 (비우면 OpenAI 기본)
OPENAI_BASE_URL=
LLM_MODEL=

# Kakao REST API 키 (BE/app/tools/kakao.py, pipeline/*). 개발자 콘솔 > 앱 > 앱 키 > REST API 키
# BE/.env 또는 BE/.env.local 에 넣는다 (.env.local 이 우선). 둘 다 커밋하지 않는다.
KAKAO_REST_API_KEY=

# 공공데이터포털(data.go.kr) 일반 인증키. Encoding/Decoding 어느 쪽을 넣어도 된다 (app/publicdata.py 가 맞춘다).
# 전월세 실거래가(국토부), 건축물대장(건축HUB), 상가(상권)정보(소상공인시장진흥공단) 모두 이 키 하나로 호출
DATA_GO_KR_SERVICE_KEY=
# 선택: 실거래·상가정보 CSV (쉼표로 여러 파일, 상대 경로는 BE/ 기준). 비우면 DB/staging 의 가장 최근 rent_tx_*.csv,
# stores_*.csv 는 전부 읽되 업종마다 가장 최근 파일 (헬스장만 따로 수집해도 합쳐짐)
MARKET_TX_PATH=
STORES_PATH=
# 선택: 건축물대장 결과 CSV (쉼표). 비우면 DB/staging 의 building_titles_*.csv 전부 (지번마다 가장 최근 성공 행)
BUILDING_TITLES_PATH=
# 선택: 지하철역·버스정류장·공원 CSV (pipeline.collect_poi). 비우면 DB/staging 의 가장 최근 poi_*.csv
POI_PATH=
# 챗봇 제외 조건(술집 근처 싫어 등) 장소 확인: local(기본, 상가정보·호출 없음) | kakao(카카오 Local, 키 필요·호출 상한)
PLACE_SEARCH=local

# 주거 지원 정책 안내 (온통청년 청년정책 OPEN API, pipeline.collect_policies). 자격 판정은 하지 않는다.
# 키: 온통청년 회원가입 → 마이페이지 → 오픈(OPEN) API 신청 → 담당자 승인 후 발급
YOUTHCENTER_API_KEY=
# 선택: 요청 주소·매개변수 이름 (기본값은 공식 안내 예시. 발급 후 명세와 다르면 바꾼다)
YOUTHCENTER_API_URL=
YOUTHCENTER_KEY_PARAM=
YOUTHCENTER_PAGE_PARAM=
YOUTHCENTER_SIZE_PARAM=
YOUTHCENTER_EXTRA_PARAMS=
# 선택: 정책 JSON (비우면 DB/staging 의 가장 최근 policies_*.json)
POLICIES_PATH=
