# 쉼표로 구분한 허용 Origin 목록 (비우면 기본값 http://localhost:5173)
CORS_ORIGINS=
# 매물 CSV 경로 (비우면 기본값 ../DB/poc_ewha.csv). 상대 경로는 BE/ 기준.
# 예: 이대 주변 직방 월세 데이터 (pipeline 으로 만든 로컬 파일, 커밋 안 함) ../DB/staging/ewha_candidates_v2_student.csv
DATA_CSV_PATH=
# 매물 × 강의동 도보시간 표 (pipeline.build_walk_table). 비우면 매물 CSV 의 강의동 4곳(spot1~4)만 씀. 상대 경로는 BE/ 기준.
WALK_TABLE_PATH=

# LLM (scripts/ask.py)
OPENAI_API_KEY=
# 선택: OpenRouter 등 OpenAI 호환 엔드포인트 (비우면 OpenAI 기본)
OPENAI_BASE_URL=
LLM_MODEL=

# Kakao REST API 키 (BE/app/tools/kakao.py, pipeline/*). 개발자 콘솔 > 앱 > 앱 키 > REST API 키
# BE/.env 또는 BE/.env.local 에 넣는다 (.env.local 이 우선). 둘 다 커밋하지 않는다.
KAKAO_REST_API_KEY=
